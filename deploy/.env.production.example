# Copy to deploy/.env.production and fill in. Never commit the real file.
NODE_ENV=production

# Required. Signs every login. Generate: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=change-me

# Required in production: public https origin of the site (CORS + links in emails). No trailing slash.
WEB_ORIGIN=https://example.com

# Set true only because a proxy you control (Caddy/Cloudflare) sits in front, so rate limits see real IPs.
TRUST_PROXY=true

# Comma-separated emails that become admins at sign-up/login (case-insensitive).
ADMIN_EMAILS=you@example.com

# Paths inside the container (the /data volume). Normally leave as is (also set in the image).
DB_PATH=/data/connectly.db
UPLOAD_DIR=/data/uploads
PORT=3001

# Payment details shown to members for UPI payments. Use real, verified details.
PAYMENT_PAYEE_NAME=
PAYMENT_UPI_ID=

# Web push. Generate once: (cd api && node src/scripts/generate-vapid-keys.ts)
# Changing the pair invalidates all browser subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: allow image messages in chat (off by default; the community has no photos).
# ALLOW_CHAT_IMAGES=true

# Email: the API bundles no SMTP client (api/src/mailer.ts has a pluggable setMailer). These are
# placeholders for when a mailer is wired in; the API does not read them today.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Connectly <no-reply@example.com>"

# RATE_LIMIT must stay UNSET in production (RATE_LIMIT=off disables rate limiting; tests only).
