# Copy to api/.env (git-ignored). Never commit real values.
WEB_ORIGIN=http://localhost:5173

# Email (Gmail App Password for testing; see docs/EMAIL.md). Leave SMTP_HOST empty to log mail to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Connectly <your.address@gmail.com>"
